import 'package:flutter_test/flutter_test.dart';
import 'package:ai_core_os/core/ai/memory/memory_engine.dart';
import 'package:ai_core_os/core/ai/memory/stores/in_memory_store.dart';

void main() {
  late MemoryEngine engine;

  setUp(() {
    // InMemoryStore هو الـ Implementation اللي بنثبت بيه الـ Engine في v1.1
    engine = MemoryEngine(store: InMemoryStore());
  });

  group('MemoryEngine v1.1 - Core Contract', () {
    test('1- should create engine', () {
      expect(engine, isNotNull);
    });

    test('2- add single memory', () async {
      final mem = await engine.remember(content: 'test memory content');
      expect(mem.id, isNotEmpty);
    });

    test('3- getById retrieves same memory', () async {
      final mem = await engine.remember(content: 'hello world');
      final fetched = await engine.getById(mem.id);
      expect(fetched?.content, 'hello world');
    });

    test('4- search by words', () async {
      await engine.remember(content: 'Flutter is awesome');
      await engine.remember(content: 'Dart is fast');
      final results = await engine.search('Flutter');
      expect(results.length, 1);
      expect(results.first.content, contains('Flutter'));
    });

    test('5- forget deletes memory', () async {
      final mem = await engine.remember(content: 'to be deleted');
      await engine.forget(mem.id);
      final fetched = await engine.getById(mem.id);
      expect(fetched, isNull);
    });

    test('6- getById updates lastAccess and accessCount', () async {
      final mem = await engine.remember(content: 'access test');
      final beforeCount = mem.accessCount;
      await Future.delayed(Duration(milliseconds: 10));
      await engine.getById(mem.id);
      final after = await engine.getById(mem.id);
      expect(after!.accessCount, greaterThan(beforeCount));
      expect(after.lastAccess.isAfter(mem.lastAccess), isTrue);
    });

    test('7- forget removes from indexes (Trie/Inverted)', () async {
      final mem = await engine.remember(content: 'unique_keyword_xyz');
      var results = await engine.search('unique_keyword_xyz');
      expect(results.length, 1);
      await engine.forget(mem.id);
      results = await engine.search('unique_keyword_xyz');
      expect(results, isEmpty);
    });

    test('8- stats returns basic counts', () async {
      await engine.remember(content: 'one');
      await engine.remember(content: 'two');
      final stats = await engine.stats();
      expect(stats.totalCount, 2);
    });
  });
}
